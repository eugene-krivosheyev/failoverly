# BUILD TIME: public canonical origin. The default is already site.config.json.
# Copy to .env only if you need a local override. Never put secrets in SITE_URL.
SITE_URL=https://failoverly.app

# DEPLOY: connect the GitHub repository in Vercel and select main as Production Branch.
# Native Git deployments need no GitHub Actions secrets or variables.
# For manual CLI deployments, use bunx vercel@59.17.0 login and link;
# the ignored .vercel/project.json stores the linked project IDs. See README.md.

# RUNTIME: none. The native Kit embed submits directly to Kit.
# Public form UID: eba19436d6; form ID: 9949657.
# No Kit API key, server endpoint or secret build variable is needed.
# Configure incentive email, confirmation and sender/domain in the Kit dashboard.
# Never put provider credentials in HTML, browser JS or public build variables.
