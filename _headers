# Cloudflare Pages headers.
# Все ассеты в dist/ имеют хэш в имени файла (сборка bun) — их можно кэшировать вечно.
# index.html — единственный нехэшированный файл, его всегда ревалидируем.

/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/llms.txt
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
